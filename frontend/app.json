{
  "expo": {
    "name": "LOPI",
    "slug": "lopi-social",
    "version": "1.0.0",
    "description": "LOPI \u2014 \u00bfQu\u00e9 hay pa' hacer? Descubre y \u00fanete a parches (planes) con amigos y personas nuevas en tu ciudad.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lopi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.lopisocial.of0scu"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3B4CF6"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.lopisocial.of0scu"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "LOPI",
      "shortName": "LOPI",
      "description": "LOPI \u2014 \u00bfQu\u00e9 hay pa' hacer? Descubre y \u00fanete a parches con amigos y personas nuevas en tu ciudad.",
      "themeColor": "#3B4CF6",
      "backgroundColor": "#3B4CF6",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "lang": "es",
      "meta": {
        "apple-mobile-web-app-capable": "yes",
        "apple-mobile-web-app-status-bar-style": "black-translucent",
        "apple-mobile-web-app-title": "LOPI",
        "mobile-web-app-capable": "yes"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "android": false,
            "ios": false,
            "default": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3B4CF6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}